### PROJECT NAME
COMPOSE_PROJECT_NAME=nas

### PATHS
ROOT_PATH="${ROOT_PATH:?err}"

APPS_FOLDER="$ROOT_PATH/apps"
SCRIPTS_FOLDER="$ROOT_PATH/../../src/app-bootstrap"

### ACCESS
# File access, date and time details for the containers / applications to use.
# Run "sudo id docker" on host computer to find PUID / PGID and update these to suit.
PUID=1000
PGID=1000

### CUSTOMISATION
TIMEZONE=Europe/Paris
