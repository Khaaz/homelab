<?xml version="1.0" encoding="utf-8"?>
<Preferences 
    PlexOnlineToken="${PLEX_CLAIM}"
    PlexOnlineUsername="${PLEX_USERNAME}"
    PlexOnlineMail="${PLEX_EMAIL}"
    customConnections="https://plex.${EXTERNAL_DOMAIN}/,https://plex.${MS_DOMAIN}/,http://${MS_HOST_IP}:${PORT_UI_PLEX}/"
    MachineIdentifier="${PLEX_MACHINE_IDENTIFIER}"
    FriendlyName="media-server"

    PublishServerOnPlexOnlineKey="0"
    EnableIPv6="0"
    PreferredNetworkInterface="eth0"
    RelayEnabled="0"
    LastAutomaticMappedPort="0"

    FSEventLibraryPartialScanEnabled="0"
