    ScheduledLibraryUpdateInterval="900"
    FSEventLibraryUpdatesEnabled="1"
    TranscoderCanOnlyRemuxVideo="0"
    TranscodeCountLimit="10"
    TranscoderTempDirectory="/transcode"
    AcceptedEULA="1"
    LanguageInCloud="1"
    MergedRecentlyAdded="0" 
    GlobalMusicVideoPathMigrated="1"

    LogVerbose="0"
    sendCrashReports="0"
    MetricsEpoch="1"
