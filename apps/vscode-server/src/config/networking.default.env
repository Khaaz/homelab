### HOST
# IP of the machine that host this docker-compose app
VSCODE_SERVER_HOST_IP=127.0.0.1
# Define a custom subdomain. Root domain should always be the same
VSCODE_SERVER_DOMAIN="l.ab"

### SUBNET
# Docker subnet used for this compose network
VSCODE_SERVER_DOCKER_SUBNET=172.19.1

### PORTS
# Defaults ports, change if needed
PORT_UI_VSCODE_SERVER=8086
