### HOST
# IP of the machine that host this docker-compose app
MEDIA_MANAGEMENT_HOST_IP=
# Define a custom subdomain. Root domain should always be the same
MEDIA_MANAGEMENT_DOMAIN="l.ab"

### SUBNET
# Docker subnet used for this compose network
MEDIA_MANAGEMENT_DOCKER_SUBNET=172.18.10
MEDIA_MANAGEMENT_DOCKER_SUBNET_VPN=172.18.11

LOCAL_SUBNET=192.168.1.0/24             # This is the IP Subnet used on your home network

### PORTS
# Defaults ports, change if needed
PORT_UI_PORTAINER=9000

PORT_SERVICE_GLUETUN=8320

PORT_UI_PROWLARR=9696
PORT_SERVICE_FLARESOLVERR=8191
PORT_UI_QBITTORRENT=8200
PORT_SERVICE_QBITTORRENT=6881
# PORT_UI_SABNZBD=8100
PORT_UI_BAZARR=6767
PORT_UI_RADARR=7878
PORT_UI_RADARR4K=7879
PORT_UI_SONARR=8989
PORT_UI_SONARR4K=8988
PORT_UI_HOMARR=7575
PORT_UI_MAINTAINERR=6246
