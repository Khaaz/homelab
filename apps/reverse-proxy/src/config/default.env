### PROJECT NAME
COMPOSE_PROJECT_NAME=reverse-proxy

### PATHS
ROOT_PATH="${ROOT_PATH:?err}"
APPS_FOLDER="$ROOT_PATH/apps"
SCRIPTS_FOLDER="$ROOT_PATH/../../src/scripts"

### ACCESS
# File access, date and time details for the containers / applications to use.
# Run "sudo id docker" on host computer to find PUID / PGID and update these to suit.
PUID=1000
PGID=1000
UMASK=0002

### CUSTOMISATION
TIMEZONE=Europe/Paris

### CA
# Common name for root certificate of Cert auth generated by minica
ROOT_CA_COMMON_NAME="Homelab"

### PROXY
# Swag settings
VALIDATION=dns
SUBDOMAINS=wildcard
PROPAGATION=
ONLY_SUBDOMAINS=true
