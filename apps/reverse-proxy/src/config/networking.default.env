### SERVER
# IP of the machine that host the server
PROXMOX_DOMAIN=

### HOST
# IP of the machine that host this docker-compose app
REVERSE_PROXY_HOST_IP=

### SUBNET
# Docker subnet used for this compose network
REVERSE_PROXY_DOCKER_SUBNET=172.20.1

### PORTS
# Defaults ports, change if needed
PORT_UI_PORTAINER=9000
PORT_UI_PROXMOX=8006
PORT_UI_DDNS_UPDATER=8310
